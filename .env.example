# Copy this file to `.env` to override the Docker Compose defaults.
# No real AWS account or real credentials are required: LocalStack accepts
# these dummy values and emulates SNS locally.

# ---------------------------------------------------------------- postgres
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass123
POSTGRES_PORT=5432

# ------------------------------------------------------------------- ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------------------------------------------------------- LocalStack/AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_TOPIC_NAME=fraud-alerts
SQS_QUEUE_NAME=fraud-alerts-queue
NOTIFICATIONS_ENABLED=true
LOCALSTACK_DEBUG=0

# ----------------------------------------------------------------- backend
# DATABASE_URL is only needed when running the backend outside Docker.
# Inside Docker Compose the backend service sets it automatically.
DATABASE_URL=postgresql+psycopg2://fraud_user:fraud_pass123@localhost:5432/fraud_db
AWS_ENDPOINT_URL=http://localhost:4566
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ------------------------------------------------------------ fraud tuning
VELOCITY_MAX_TRANSACTIONS=5
VELOCITY_WINDOW_MINUTES=10
AMOUNT_MULTIPLIER=10
MAX_TRAVEL_SPEED_KMH=1000
HIGH_RISK_THRESHOLD=60

# ---------------------------------------------------------------- frontend
# URL the *browser* uses to reach the backend (host machine perspective).
VITE_API_URL=http://localhost:8000
